export const CURRENT_SEASON = (): string => {
  const month = new Date().getMonth();
  if (month === 11 || month === 0 || month === 1) return 'Winter';
  if (month === 2 || month === 3) return 'Spring';
  if (month === 4 || month === 5) return 'Summer';
  return 'Monsoon'; // June - September
};

